<html>
<head>
  <title>Add Book</title>
  <link href="bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="container py-5">
    <a class="btn btn-primary" href="/">Home</a>
    <a class="btn btn-primary" href="/view-books">View All Books</a>
    <h3 class="my-3">Add New Book</h3>
    <div class="card shadow-sm" style="max-width: 400px;">
      <div class="card-body">
        <form action="/add-book" method="POST">
          <div class="mb-3">
            <label class="form-label">Book Name</label>
            <input class="form-control" name="title" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Author Name</label>
            <input class="form-control" name="author" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Publication Year</label>
            <input class="form-control" type="number" name="year" required>
          </div>
          <button class="btn btn-primary" type="submit">Submit</button>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
