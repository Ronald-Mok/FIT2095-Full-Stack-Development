<html>
<head>
  <title>All Books</title>
  <link href="bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="container py-5">
    <a class="btn btn-primary" href="/">Home</a>
    <a class="btn btn-primary" href="/add-book">Add New Book</a>
    <h3 class="my-3">All Books</h3>
    <table class="table table-hover">
      <thead>
        <tr><th>Id</th><th>Book Name</th><th>Author</th><th>Published Year</th></tr>
      </thead>
      <tbody>
        <% records.forEach(book => { %>
          <tr>
            <td><%= book.id %></td>
            <td><%= book.title %></td>
            <td><%= book.author %></td>
            <td><%= book.year %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>
